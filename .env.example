# --- Features ---
# Dramaturg agent + Distill (default off for org-first launch).
# NEXT_PUBLIC_ENABLE_AGENT=true

# Get an API key at https://console.anthropic.com/ (only needed when agent is on)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Phase 1: shared password (optional; leave unset for open local dev) ---
# BASIC_AUTH_USER=director
# BASIC_AUTH_PASSWORD=change-me

# --- Phase 2: per-director accounts (Auth.js) ---
# Generate with: openssl rand -base64 32
# AUTH_SECRET=
# Public URL of the deployment (Railway domain). Needed in production.
# AUTH_URL=https://your-app.up.railway.app
# Set to false to disable self-serve signup (invite-only).
# ALLOW_SIGNUP=true

# --- Phase 3: object storage (optional; local volume is default) ---
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# --- Phase 4: billing + quotas ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# CHAT_QUOTA_PREP=50
# CHAT_QUOTA_DRAMATURG=500
