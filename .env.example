# --- Features ---
# Dramaturg agent + Distill (default off for org-first launch).
# NEXT_PUBLIC_ENABLE_AGENT=true

# Paid-tier (Solo/Pro) Checkout + upgrade CTAs (default off until Stage 4 Stripe).
# NEXT_PUBLIC_ENABLE_BILLING_CHECKOUT=true
# Legacy alias (still works): NEXT_PUBLIC_ENABLE_ORGANIZE_CHECKOUT=true

# Get an API key at https://console.anthropic.com/ (only needed when agent is on)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Phase 1: shared password (optional; leave unset for open local dev) ---
# BASIC_AUTH_USER=director
# BASIC_AUTH_PASSWORD=change-me

# --- Phase 2: per-director accounts (Auth.js) ---
# Generate with: openssl rand -base64 32
# AUTH_SECRET=
# Public URL of the deployment (Railway domain). Needed in production.
# AUTH_URL=https://your-app.up.railway.app
# Set to false to disable self-serve signup (invite-only).
# ALLOW_SIGNUP=true

# --- Stage 5a: hosted SQLite (Turso) ---
# Local default is file:./data/performancenotes.db (no env needed).
# On Railway, set both to drop the SQLite volume dependency for the DB:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# --- Phase 3 / Stage 5b: object storage (optional; local volume is default) ---
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# --- Stage 4: Stripe billing (Solo + Pro subscriptions) ---
# Secret key + Pro price are required for checkout; webhook secret for plan sync.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Pro tier ($15/mo)
# STRIPE_PRICE_PRO=price_...
# Legacy alias (still works): STRIPE_PRICE_ORGANIZE=price_...
# Solo tier (1 project, unlimited scenes)
# STRIPE_PRICE_SOLO=price_...
# Redirect base URL for Checkout/Portal (falls back to AUTH_URL, then request origin).
# APP_URL=https://your-app.up.railway.app

# --- Quotas (Agent tier, Stage 7) ---
# CHAT_QUOTA_PREP=50
# CHAT_QUOTA_DRAMATURG=500
